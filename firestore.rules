rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Data toko: siapa saja boleh membaca (untuk ditampilkan di website publik).
    // Menulis/mengubah/menghapus HANYA boleh oleh admin yang sudah login
    // lewat Firebase Authentication (email & password asli).
    match /store_data/{docId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /data/{itemId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Semua koleksi lain: tertutup total secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

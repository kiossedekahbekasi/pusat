rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Daftar UID admin yang boleh menulis data toko.
    // CARA PAKAI (SANGAT DISARANKAN):
    //   1. Buka Firebase Console > Authentication > Users, salin UID akun admin.
    //   2. Masukkan UID tersebut ke daftar di bawah ini.
    //   3. Deploy ulang aturan ini, lalu ganti isAdmin() pada blok write.
    // Selama daftar masih kosong, aturan memakai pemeriksaan longgar
    // (siapa pun yang login) supaya aplikasi tetap berjalan.
    function adminUids() {
      return [
        // 'ganti_dengan_UID_admin_anda',
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid in adminUids();
    }

    // Data toko: siapa saja boleh membaca (untuk ditampilkan di website publik).
    // Menulis/mengubah/menghapus hanya boleh oleh akun yang sudah login.
    // Setelah adminUids() diisi, ganti `isSignedIn()` di bawah menjadi `isAdmin()`
    // agar akun Firebase lain tidak bisa mengubah data toko.
    match /store_data/{docId} {
      allow read: if true;

      // Dokumen "orders" HARUS boleh ditulis oleh pengunjung biasa (belum login),
      // karena pesanan dibuat oleh PEMBELI di halaman publik, bukan oleh admin.
      // Sebelumnya aturan ini mewajibkan isSignedIn() untuk SEMUA dokumen termasuk
      // "orders", sehingga setiap kali pembeli checkout, penyimpanan ke Firestore
      // gagal dengan "permission-denied" secara diam-diam (order.ts hanya
      // console.warn). Akibatnya pesanan cuma tersimpan di localStorage HP/browser
      // pembeli sendiri dan TIDAK PERNAH sampai ke Panel Admin di perangkat lain —
      // itulah sebabnya dashboard admin selalu menampilkan "0 Pesanan" walau
      // pembeli sudah checkout. Dokumen lain (produk, info toko, dsb.) tetap
      // hanya boleh ditulis oleh admin yang sudah login.
      allow write: if docId == 'orders' || isSignedIn();

      match /data/{itemId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Semua koleksi lain: tertutup total secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Products catalog for Sembako store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "minWholesaleQty": { "type": "number" },
        "unit": { "type": "string" },
        "stock": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "isBestSeller": { "type": "boolean" },
        "badge": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "unit", "stock"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "deliveryType": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "totalAmount": { "type": "number" },
